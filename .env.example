APP_URL=http://localhost:3000

# Serve the in-memory MOCK backend (server-side). Not a secret; omit in production.
# In a production build the mock stays off unless ALLOW_MOCK_BACKEND_IN_PRODUCTION=true.
NEXT_PUBLIC_API_MOCKING=enabled

# --- Authentication (server-side only; never use NEXT_PUBLIC_* for these) ---
# Session encryption secret, at least 32 characters. Generate with: openssl rand -base64 32
# Without it nobody can authenticate (fail closed).
AUTH_SECRET=

# Development/test login. Only active when mock mode is on. Choose any password;
# users: reviewer, viewer, main-reviewer. Never set in a real deployment.
AUTH_DEV_PASSWORD=

# Optional OpenID Connect provider. All three must be set to enable it.
# ASSUMPTION: the IdP issues `app_role` (viewer|reviewer) and `app_tenants` (string[]) claims.
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
