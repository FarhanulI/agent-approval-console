# Public application origin; use HTTPS in production.
APP_URL=http://localhost:3000

# Development/test only. Leave empty for a real deployment; never expose secrets through NEXT_PUBLIC_*.
NEXT_PUBLIC_API_MOCKING=
# Server-side only. Explicitly acknowledge simulation mode only for production E2E tests.
ALLOW_MOCK_BACKEND_IN_PRODUCTION=

# --- Authentication (server-side only; never use NEXT_PUBLIC_* for these) ---
# Required at runtime; at least 32 characters. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Development/test login only. Active only when mock mode is on.
AUTH_DEV_PASSWORD=

# Production authentication: configure all three OIDC values together.
# The IdP must issue `app_role` (viewer|reviewer) and `app_tenants` (string[]) claims.
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
